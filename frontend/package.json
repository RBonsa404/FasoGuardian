{
  "name": "fasoguardian-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:tout",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "serve:ssr:site": "node dist/site/server/server.mjs",
    "serve:ssr:public-qr": "node dist/public-qr/server/server.mjs",
    "importer:design": "node tools/importer-design.mjs",
    "build:parents": "ng build parents && node tools/generer-precache.mjs",
    "build:tout": "ng build ui && ng build api && npm run build:parents && ng build public-qr && ng build console && ng build site",
    "budgets": "node tools/verifier-budgets.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "gabarit:qr": "ng build public-qr && node tools/gabarit-qr.mjs",
    "icones:pwa": "node tools/generer-icones-pwa.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "dexie": "^4.4.6",
    "express": "5.2.1",
    "leaflet": "1.9.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "@angular/localize": "22.2.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.20.5",
    "jsdom": "30.1.2",
    "ng-packagr": "22.2.4",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
