# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env.
# Les valeurs ci-dessous sont des exemples de développement, sans valeur en production.

# PostgreSQL / PostGIS
FG_DB_NAME=fasoguardian
FG_DB_USER=fasoguardian
FG_DB_PASSWORD=
# Port publié sur le poste ; en changer si 5432 est déjà pris.
FG_DB_PORT=5432

# Serveur d'application
FG_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Broker MQTT (Mosquitto, TLS avec authentification mutuelle)
# Cle privee ECDSA P-256 (PKCS#8 DER en base64) qui signe les commandes envoyees aux bracelets.
# Generation : openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt -outform DER | openssl base64 -A
FG_CLE_COMMANDES=
# Notifications push (VAPID). Laisser vide pour n'envoyer que des SMS. Les trois valeurs vont ensemble.
# Cle privee : comme FG_CLE_COMMANDES. Cle publique (point brut en base64url) :
#   openssl pkey -in cle.pem -pubout -outform DER | tail -c 65 | openssl base64 -A | tr '+/' '-_' | tr -d '='
FG_PUSH_CLE_PUBLIQUE=
FG_PUSH_CLE_PRIVEE=
FG_PUSH_SUJET=mailto:contact@exemple.bf
FG_MQTT_PORT=8883
# Connexion du serveur au broker hors Compose (Compose les fixe lui-meme). Sans FG_MQTT_URL, le serveur ne s'abonne pas.
# FG_MQTT_URL=ssl://localhost:8883
# FG_MQTT_AUTORITE=infra/certs/ca.crt
# FG_MQTT_CERTIFICAT=infra/certs/serveur.crt
# FG_MQTT_CLE=infra/certs/serveur.key

# Observabilité
FG_GRAFANA_ADMIN_PASSWORD=

# Proxy inverse (HTTPS)
FG_PROXY_PORT=8443

# Clés de chiffrement applicatif : une valeur distincte par ligne, générée par « openssl rand -base64 32 »
FG_CLE_EMPREINTE=
FG_JWT_SECRET=
FG_CLE_TELEPHONE=
FG_CLE_PIECE_KYC=
FG_CLE_SANTE=
FG_CLE_SECRET_MFA=
FG_CLE_IMEI=
FG_CLE_PROFIL_ENFANT=
FG_CLE_SIGNALEMENT=

# Adaptateur SMS : bac-a-sable (aucun envoi réel) tant que l'agrégateur n'est pas choisi
FG_SMS_ADAPTATEUR=bac-a-sable

# Adresse publique de l'application Parents (liens envoyés par SMS)
FG_URL_PARENTS=https://app.exemple.bf

# Cascade des alertes sans réponse : numéro du point de contact institutionnel convenu (vide : pas d'étape institutionnelle)
FG_CASCADE_CONTACT_INSTITUTIONNEL=

# Analyse d'impact (AIPD) : obligatoire pour le profil prod, qui refuse de démarrer sans ces trois valeurs
FG_AIPD_REFERENCE=
FG_AIPD_VALIDEE_LE=
FG_DELEGUE_PROTECTION_DONNEES=

# Secret partagé avec la passerelle des SMS de repli des bracelets (openssl rand -hex 32) ; vide : canal fermé
FG_SMS_SECRET_PASSERELLE=

# Paiement mobile money : bac-a-sable (aucun débit réel) tant que l'agrégateur n'est pas choisi
FG_PAIEMENTS_ADAPTATEUR=bac-a-sable
# Secret partagé qui authentifie les notifications de l'agrégateur (openssl rand -hex 32)
FG_PAIEMENTS_SECRET_WEBHOOK=
# Bac à sable seulement : délai au bout duquel il confirme lui-même un paiement (PT5S) ; vide, il ne répond pas
FG_PAIEMENTS_VALIDATION_APRES=
# Offre appliquée à un enfant sans abonnement payé (INTERMEDIAIRE pendant le pilote) ; vide : droits restreints
FG_OFFRE_D_ACCUEIL=

# Premier administrateur de la console (créé si aucun agent n'existe ; 12 caractères au moins)
FG_ADMIN_IDENTIFIANT=
FG_ADMIN_MOT_DE_PASSE=
