# Blocs « server » de la plateforme (ADR 0040). Modèle complété au démarrage par l'image nginx : seules les
# variables d'environnement définies (FG_DOMAINE, FG_DOMAINE_CONSOLE, FG_ANDROID_PAQUET, FG_ANDROID_EMPREINTE)
# sont remplacées ; les variables de nginx ($host, $uri…) restent telles quelles.

# Domaine public : site à la racine, application Parents sous /app/, page QR sous /q/, API sous /api/.
server {
    listen 8443 ssl;
    http2 on;
    server_name ${FG_DOMAINE};

    ssl_certificate     /etc/nginx/certs/proxy.crt;
    ssl_certificate_key /etc/nginx/certs/proxy.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    include /etc/nginx/entetes/site.conf;
    include /etc/nginx/proxy-serveur.conf;

    # Supervision : jamais exposée à l'extérieur, Prometheus interroge le serveur sur le réseau interne.
    location /actuator {
        return 404;
    }

    # Page publique QR : rendue par le serveur, jamais mise en cache.
    location /q/ {
        include /etc/nginx/entetes/api.conf;
        limit_req zone=public burst=20 nodelay;
        proxy_pass http://serveur;
    }

    location /api/v1/public/ {
        include /etc/nginx/entetes/api.conf;
        limit_req zone=public burst=20 nodelay;
        proxy_pass http://serveur;
    }

    location /api/v1/auth/ {
        include /etc/nginx/entetes/api.conf;
        limit_req zone=authentification burst=10 nodelay;
        proxy_pass http://serveur;
    }

    # La console a son propre nom : ses appels n'ont rien à faire sur le domaine public.
    location /api/v1/console/ {
        return 404;
    }

    location /api/ {
        include /etc/nginx/entetes/api.conf;
        proxy_pass http://serveur;
    }

    # Lien entre l'application Android (Trusted Web Activity) et ce domaine : sans lui, Android ouvrirait
    # l'application dans un onglet de navigateur avec sa barre d'adresse.
    location = /.well-known/assetlinks.json {
        include /etc/nginx/entetes/api.conf;
        default_type application/json;
        return 200 '[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"${FG_ANDROID_PAQUET}","sha256_cert_fingerprints":["${FG_ANDROID_EMPREINTE}"]}}]';
    }

    # Application Parents (PWA) : les fichiers à empreinte se gardent un an, l'entrée, le service worker et le
    # manifeste jamais, pour qu'une nouvelle version soit prise dès sa mise en ligne.
    location = /app {
        return 301 /app/;
    }

    location /app/ {
        include /etc/nginx/entetes/parents.conf;
        alias /usr/share/fasoguardian/parents/;
        try_files $uri $uri/ /app/index.html;
        location ~* ^/app/(index\.html|sw\.js|manifest\.webmanifest|precache\.json|theme\.js)$ {
            include /etc/nginx/entetes/parents.conf;
            add_header Cache-Control "no-cache";
            alias /usr/share/fasoguardian/parents/$1;
        }
        location ~ "^/app/(.+-[A-Za-z0-9_-]{8}\.(?:js|css))$" {
            include /etc/nginx/entetes/parents.conf;
            add_header Cache-Control "public, max-age=31536000, immutable";
            alias /usr/share/fasoguardian/parents/$1;
        }
    }

    # Site public prérendu : chaque page est un fichier index.html dans le dossier de sa route.
    location / {
        root /usr/share/fasoguardian/site;
        try_files $uri $uri/index.html =404;
    }
}

# Console des agents : un nom à part, que l'exploitant peut réserver au réseau de l'équipe.
server {
    listen 8443 ssl;
    http2 on;
    server_name ${FG_DOMAINE_CONSOLE};

    ssl_certificate     /etc/nginx/certs/proxy.crt;
    ssl_certificate_key /etc/nginx/certs/proxy.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    include /etc/nginx/entetes/console.conf;
    include /etc/nginx/proxy-serveur.conf;

    location /actuator {
        return 404;
    }

    location /api/v1/auth/ {
        include /etc/nginx/entetes/api.conf;
        limit_req zone=authentification burst=10 nodelay;
        proxy_pass http://serveur;
    }

    location /api/ {
        include /etc/nginx/entetes/api.conf;
        proxy_pass http://serveur;
    }

    location / {
        include /etc/nginx/entetes/console.conf;
        root /usr/share/fasoguardian/console;
        try_files $uri $uri/ /index.html;
        location = /index.html {
            include /etc/nginx/entetes/console.conf;
            add_header Cache-Control "no-cache";
        }
    }
}
